* { margin: 0; padding: 0; box-sizing: border-box; font-family: Arial, Helvetica, sans-serif; }
body { background: #f5f6f8; }

.app-shell { height: 100vh; display: flex; flex-direction: column; }

/* HEADER */
.app-header { height: 60px; background: #1a1a1a; display: flex; align-items: center; justify-content: space-between; padding: 0 20px; }
.header-brand { display: flex; align-items: center; gap: 10px; }
.brand-icon { font-size: 20px; }
.brand-name { font-weight: bold; font-size: 18px; color: #fff; }
.header-nav { display: flex; gap: 20px; }
.nav-link { text-decoration: none; color: #aaa; font-size: 14px; transition: color 0.2s; }
.nav-link:hover, .nav-link.active { color: #fff; }
.api-badge { font-size: 12px; color: #666; background: #2a2a2a; border: 1px solid #444; padding: 4px 10px; border-radius: 20px; }

/* BODY */
.app-body { flex: 1; display: flex; overflow: hidden; }

/* SIDEBAR */
.app-sidebar { width: 220px; background: #fff; border-right: 1px solid #e5e5e5; padding: 20px 14px; flex-shrink: 0; }
.sidebar-label { font-size: 11px; font-weight: 700; color: #aaa; letter-spacing: 1px; margin-bottom: 10px; padding-left: 10px; }
.sidebar-item { display: flex; align-items: center; gap: 10px; padding: 10px 12px; text-decoration: none; color: #444; border-radius: 8px; margin-bottom: 4px; font-size: 14px; transition: background 0.15s, color 0.15s; }
.sidebar-item:hover { background: #f0f0f0; }
.sidebar-item.active { background: #1a1a1a; color: #fff; }
.sidebar-icon { font-size: 15px; width: 20px; }

/* MAIN CONTENT */
.app-main { flex: 1; padding: 28px; overflow-y: auto; }

/* ADS */
.app-ads { width: 220px; background: #fafafa; border-left: 1px solid #e5e5e5; padding: 20px; flex-shrink: 0; }
.ads-header-label { font-size: 11px; color: #999; text-transform: uppercase; letter-spacing: 0.5px; margin-bottom: 12px; }
.ad-unit { background: #ebebeb; border-radius: 8px; display: flex; align-items: center; justify-content: center; margin-bottom: 14px; }
.ad-tall { height: 220px; }
.ad-medium { height: 130px; }
.ad-label { font-size: 12px; color: #aaa; }
